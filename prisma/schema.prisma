generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ========== USUARIOS ==========
model User {
  id           Int             @id @default(autoincrement())
  email        String          @unique
  password     String
  name         String?
  phone        String?
  address      String?
  avatar       String?         // URL de imagen de perfil
  role         Role            @default(USER)
  
  // Campos de estado
  isActive     Boolean         @default(true)
  isVerified   Boolean         @default(false)
  emailVerified Boolean        @default(false)
  
  // Campos de seguridad
  loginAttempts Int            @default(0)
  lockedUntil   DateTime?      // Bloqueo temporal por muchos intentos
  lastLogin     DateTime?
  lastPasswordChange DateTime?
  
  // Campos de auditoría
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?       // Soft delete
  
  // Relaciones
  cart         Cart?
  orders       Order[]
  refreshTokens RefreshToken[]
  userActivities UserActivity[]
  roleHistory UserRoleHistory[]
  changedRoles UserRoleHistory[] @relation("ChangedByUser")
  
  @@map("users")
  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([createdAt])
  @@index([deletedAt])
}

model UserActivity {
  id          Int       @id @default(autoincrement())
  userId      Int
  action      String    // 'LOGIN', 'LOGOUT', 'PASSWORD_CHANGE', 'PROFILE_UPDATE', 'ORDER_CREATED'
  ipAddress   String?
  userAgent   String?
  metadata    Json?     // Información adicional en JSON
  performedAt DateTime  @default(now())
  
  // Relaciones
  user User @relation(fields: [userId], references: [id])
  
  @@map("user_activities")
  @@index([userId])
  @@index([action])
  @@index([performedAt])
}

// ========== ROLES ==========
model UserRoleHistory {
  id          Int       @id @default(autoincrement())
  userId      Int
  previousRole Role
  newRole     Role
  changedBy   Int?      // ID del admin que realizó el cambio
  reason      String?
  notes       String?
  changedAt   DateTime  @default(now())
  
  // Relaciones
  user User @relation(fields: [userId], references: [id])
  changedByUser User? @relation("ChangedByUser", fields: [changedBy], references: [id])
  
  @@map("user_role_history")
  @@index([userId])
  @@index([changedAt])
  @@index([newRole])
}

// ========== PRODUCTOS ==========
model Product {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  price        Int
  stock        Int      @default(0)
  minStock     Int      @default(10)    // Stock mínimo para alertas
  maxStock     Int?     // Stock máximo recomendado
  sku          String?  @unique
  category     String?
  barcode      String?  @unique
  image        String?
  isActive     Boolean  @default(true)
  isAvailable  Boolean  @default(true)  // Disponible para venta
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Nuevos campos para gestión de stock
  lastRestockedAt DateTime?
  lastSoldAt      DateTime?
  totalSold       Int      @default(0)
  
  // Relaciones
  cartItems   CartItem[]
  orderItems  OrderItem[]
  stockMovements StockMovement[]
  cost CostHistory[]
  record RestockRecord[]
  
  @@map("products")
  @@index([sku])
  @@index([category])
  @@index([barcode])
  @@index([isAvailable])
  @@index([stock])
}

// ========== MOVIMIENTOS DE STOCK ==========
model StockMovement {
  id          Int       @id @default(autoincrement())
  productId   Int
  type        StockMovementType
  quantity    Int
  previousStock Int
  newStock    Int
  referenceId Int?      // orderId, adjustmentId, etc.
  referenceType String? // 'ORDER', 'ADJUSTMENT', 'RESTOCK', 'RETURN'
  reason      String?
  notes       String?
  performedBy Int?      // userId del administrador
  performedAt DateTime  @default(now())
  
  // Relaciones
  product Product @relation(fields: [productId], references: [id])
  
  @@map("stock_movements")
  @@index([productId])
  @@index([type])
  @@index([performedAt])
  @@index([referenceType, referenceId])
}

enum StockMovementType {
  INCREMENT  // Entrada de stock
  DECREMENT  // Salida de stock
  ADJUSTMENT // Ajuste manual
}

model RestockRecord {
  id           Int      @id @default(autoincrement())
  productId    Int
  quantity     Int
  unitCost     Int?
  totalCost    Int?
  batchNumber  String?
  expiryDate   DateTime?
  supplier     String?
  invoiceNumber String?
  notes        String?
  restockedAt  DateTime @default(now())
  
  product      Product @relation(fields: [productId], references: [id])
  
  @@map("restock_records")
  @@index([productId])
  @@index([restockedAt])
  @@index([batchNumber])
  @@index([supplier])
}

model CostHistory {
  id           Int      @id @default(autoincrement())
  productId    Int
  cost         Int      // Precio de costo
  effectiveFrom DateTime @default(now())
  effectiveTo  DateTime?
  notes        String?
  
  product      Product @relation(fields: [productId], references: [id])
  
  @@map("cost_history")
  @@index([productId])
  @@index([effectiveFrom])
}
// ========== CARRITO ==========
model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  // Relaciones
  user   User       @relation(fields: [userId], references: [id])
  items  CartItem[]
  
  @@map("carts")
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int     @default(1)
  
  // Relaciones
  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  
  @@map("cart_items")
  @@index([cartId])
  @@index([productId])
}

// ========== ÓRDENES ==========
model Order {
  id         Int          @id @default(autoincrement())
  orderNumber String      @unique @default(uuid())
  userId     Int
  total      Int
  subtotal   Int?
  tax        Int?         @default(0)
  shipping   Int?         @default(0)
  status     OrderStatus  @default(PENDING)
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  
  // Relaciones
  items     OrderItem[]
  user      User          @relation(fields: [userId], references: [id])
  payments  PaymentAttempt[]
  shippingInfo Shipping?
  statusHistory OrderStatusHistory[]
  
  @@map("orders")
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([orderNumber])
}

model OrderItem {
  id        Int @id @default(autoincrement())
  orderId   Int
  productId Int
  price     Int
  quantity  Int
  subtotal  Int // price * quantity (calculado)
  
  // Relaciones
  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  
  @@map("order_items")
  @@index([orderId])
  @@index([productId])
}

// ========== ENVÍOS ==========
model Shipping {
  id              Int       @id @default(autoincrement())
  orderId         Int       @unique
  address         String
  city            String
  state           String
  zipCode         String
  country         String    @default("Colombia")
  trackingNumber  String?
  carrier         String?   @default("Servientrega")
  status          ShippingStatus @default(PENDING)
  estimatedDelivery DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relaciones
  order Order @relation(fields: [orderId], references: [id])
  
  @@map("shippings")
  @@index([orderId])
  @@index([trackingNumber])
  @@index([status])
}

// ========== PAGOS ==========
model PaymentAttempt {
  id              Int            @id @default(autoincrement())
  orderId         Int
  amount          Int
  status          PaymentStatus
  paymentMethod   PaymentMethod
  provider        PaymentProvider @default(MOCK)
  transactionId   String?        @unique
  currency        String         @default("COP")
  cardLast4       String?
  cardBrand       String?
  errorCode       String?
  errorMessage    String?
  metadata        Json?
  isRefundable    Boolean        @default(true)
  refundedAmount  Int?           @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  // Relaciones
  order Order @relation(fields: [orderId], references: [id])
  statusHistory PaymentStatusHistory[]
  
  @@map("payment_attempts")
  @@index([orderId])
  @@index([transactionId])
  @@index([status])
  @@index([createdAt])
}

// ========== HISTORIAL ==========
model OrderStatusHistory {
  id             Int       @id @default(autoincrement())
  orderId        Int
  previousStatus String?
  newStatus      String
  changedBy      String    // 'ADMIN', 'SYSTEM', 'USER'
  reason         String?
  notes          String?
  metadata       Json?
  createdAt      DateTime  @default(now())
  
  // Relaciones
  order Order @relation(fields: [orderId], references: [id])
  
  @@map("order_status_history")
  @@index([orderId])
  @@index([createdAt])
  @@index([changedBy])
}

model PaymentStatusHistory {
  id             Int       @id @default(autoincrement())
  paymentId      Int
  previousStatus String?
  newStatus      String
  changedBy      String
  reason         String?
  metadata       Json?
  createdAt      DateTime  @default(now())
  
  // Relaciones
  payment PaymentAttempt @relation(fields: [paymentId], references: [id])
  
  @@map("payment_status_history")
  @@index([paymentId])
  @@index([createdAt])
}

// ========== TOKENS ==========
model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  revoked   Boolean  @default(false)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  
  // Relaciones
  user User @relation(fields: [userId], references: [id])
  
  @@map("refresh_tokens")
  @@index([userId])
  @@index([tokenHash])
}

// ========== ENUMS ==========
enum Role {
  USER
  ADMIN
  MODERATOR
  SUPPORT
}

enum OrderStatus {
  PENDING      // Orden creada, pendiente de pago
  PROCESSING   // Pago confirmado, preparando pedido
  PAID         // Pago completado
  SHIPPED      // Enviado al cliente
  DELIVERED    // Entregado al cliente
  COMPLETED    // Proceso finalizado
  CANCELLED    // Cancelado por usuario/admin
  REFUNDED     // Reembolsado
  RETURNED     // Devuelto por cliente
  FAILED       // Falló el proceso
}

enum PaymentStatus {
  PENDING      // Pago iniciado
  PROCESSING   // Procesando pago
  COMPLETED    // Pago exitoso
  FAILED       // Pago fallido
  REFUNDED     // Reembolsado
  CANCELLED    // Cancelado
  EXPIRED      // Expirado
  SUCCESS
}

enum PaymentMethod {
  CARD         // Tarjeta de crédito/débito
  PSE          // PSE (Colombia)
  NEQUI        // Nequi
  DAVIPLATA    // DaviPlata
  CASH         // Efectivo
  TRANSFER     // Transferencia bancaria
}

enum PaymentProvider {
  MOCK         // Para pruebas
  STRIPE       // Stripe
  WOOMPI       // Wompi (Colombia)
  PAYU         // PayU
}

enum ShippingStatus {
  PENDING      // Pendiente de envío
  PROCESSING   // Preparando envío
  SHIPPED      // Enviado
  IN_TRANSIT   // En tránsito
  DELIVERED    // Entregado
  RETURNED     // Devuelto
  FAILED       // Falló la entrega
}